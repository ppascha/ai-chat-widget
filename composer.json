{
  "name": "aicw/ai-chat-widget",
  "description": "AI Chat Widget WordPress plugin test harness and support code.",
  "type": "project",
  "require": {},
  "require-dev": {
    "phpunit/phpunit": "^11.3"
  },
  "autoload-dev": {
    "psr-4": {
      "AICW\\Tests\\Support\\": "tests/Support/"
    }
  },
  "scripts": {
    "test": [
      "phpunit --testdox"
    ],
    "coverage": [
      "phpunit --coverage-text --coverage-clover build/coverage/clover.xml --coverage-filter includes"
    ]
  }
}
